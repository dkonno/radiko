#!/bin/bash

AUTHKEY='bcd151073c03b352e1ef2fd66c32209da9ca0afa'

station_id='FMJ'
program_date=$(date '+%Y%m%d')

function filesize () {
  case $(uname -s) in
    Darwin)
      stat -f %z "$1"
      ;;
    Linux)
      stat -c %s "$1"
      ;;
    *)
      ls -l "$1" | awk '{print $5}'
      ;;
  esac
}

function relative_date () {
  if date -v+1d >/dev/null  2>&1 ; then
    date -v"$1"d '+%Y%m%d'
  elif date --date 'now' >/dev/null  2>&1 ; then
    date --date "$1 days" '+%Y%m%d'
  else
    echo 'relative date is not supported' >&2
    exit 1
  fi
}

function date_to_unixtime () {
  if date --date 'now' >/dev/null 2>&1 ; then
    date --date "$(echo $1 | awk '{print substr($1,1,4) "-" substr($1,5,2) "-" substr($1,7,2) " " substr($1,9,2) ":" substr($1,11,2) ":" substr($1,13,2)}')" '+%s'
  elif date -j >/dev/null 2>&1 ; then
    date -j -f '%Y%m%d%H%M%S' "$1" '+%s'
  else
    echo 'unknown date command options' >&2
    exit 1
  fi
}

function unixtime_to_date () {
  if date --date '@0' >/dev/null 2>&1 ; then
    date --date "@$1" '+%Y%m%d%H%M%S'
  elif date -r 0 >/dev/null 2>&1 ; then
    date -r "$1" '+%Y%m%d%H%M%S'
  else
    echo 'unknown date command options' >&2
    exit 1
  fi
}

while getopts 'd:s:l' opt ; do
  case $opt in
    d)
      case $OPTARG in
        20[0-9][0-9][0-1][0-9][0-3][0-9])
          program_date="$OPTARG" ;;
        +[0-9]|-[0-9]|-[0-9][0-9])
          program_date=$(relative_date "$OPTARG") ;;
        *)
          echo 'Invalid date format' >&2
          exit 1 ;;
      esac ;;
    s)
      station_id="$OPTARG" ;;
    l)
      program_list_only=1 ;;
    '?')
      exit 1 ;;
  esac
done
shift `expr $OPTIND - 1`

## 番組表を取得
curl -s -f -L "http://radiko.jp/v3/program/station/date/${program_date}/${station_id}.xml" -o $$.program_list || exit $?
station_name=$(xmllint --xpath "/radiko/stations/station/name/text()" $$.program_list)
echo $station_name
## -lオプションのときは番組表を保存して終了
if [ -n "$program_list_only" ] ; then
  yyyy=$(expr $program_date : '\(....\)....')
  mm=$(expr $program_date : '....\(..\)..')
  dd=$(expr $program_date : '......\(..\)')
  mv $$.program_list "${yyyy}.${mm}.${dd} ${station_name}.xml"
  exit 0
fi

## authtokenを取得（auth1）
curl -s -I -L \
  -H 'X-Radiko-App: pc_html5' \
  -H 'X-Radiko-App-Version: 0.0.1' \
  -H 'X-Radiko-User: dummy_user' \
  -H 'X-Radiko-Device: pc' \
  'https://radiko.jp/v2/api/auth1' \
| tee $$.auth1

authtoken=$(awk '/x-radiko-authtoken/ {print $2}' $$.auth1)
keylength=$(awk '/x-radiko-keylength/ {print $2}' $$.auth1)
keyoffset=$(awk '/x-radiko-keyoffset/ {print $2}' $$.auth1)
echo authtoken $authtoken
echo keylength $keylength
echo keyoffset $keyoffset

## auth2のためのpartialkeyを計算
partialkey=$(echo $AUTHKEY | awk -v keylength=$keylength -v keyoffset=$keyoffset '{print substr($1, keyoffset+1, keylength)}')

## partialkeyを使ってauthtokenを有効化（auth2）
curl -s -L \
  -H 'X-Radiko-AuthToken: '$authtoken \
  -H 'X-Radiko-PartialKey: '$(/bin/echo -n $partialkey | base64) \
  -H 'X-Radiko-User: dummy_user' \
  -H 'X-Radiko-Device: pc' \
  'https://radiko.jp/v2/api/auth2' \
| tee $$.auth2

area_id=$(awk -F, '{print $1}' $$.auth2)
echo area_id $area_id

## m3u8形式のプレイリストを取得
curl -s "https://radiko.jp/v3/station/stream/pc_html5/${station_id}.xml" >$$.${station_id}.xml
xmllint --xpath "/urls/url[@areafree='1' and @timefree='1']/playlist_create_url/text()" $$.${station_id}.xml | head -1 >$$.playlist_m3u8
playlist_m3u8=$(cat $$.playlist_m3u8)
echo $playlist_m3u8

xmllint --xpath '/radiko/stations/station/progs/prog/@ft' $$.program_list | while read ft ; do
  to=$(xmllint --xpath "/radiko/stations/station/progs/prog[@${ft}]/@to" $$.program_list | sed 's/[^0-9]*//g')
  dur=$(xmllint --xpath "/radiko/stations/station/progs/prog[@${ft}]/@dur" $$.program_list | sed 's/[^0-9]*//g')
  title=$(xmllint --xpath "/radiko/stations/station/progs/prog[@${ft}]/title/text()" $$.program_list)
  ft=$(echo ${ft} | sed 's/[^0-9]*//g')
  echo $ft $to $dur $title

  ## 番組終了前（放送中）だったらスキップする
  if [ $(date '+%Y%m%d%H%M%S') -lt $to ] ; then
    continue
  fi

  ## ファイル名にオンエア日時と番組タイトルを付ける
  yyyy=$(expr $ft : '\(....\).*')
  mm=$(expr $ft : '....\(..\).*')
  dd=$(expr $ft : '......\(..\).*')
  from_hhmm=$(expr $ft : '........\(....\).*')
  to_hhmm=$(expr $to : '........\(....\).*')
  filename="${yyyy}.${mm}.${dd}-${from_hhmm}-${to_hhmm} [${station_name}] ${title}"
  echo $filename

  ## 音声ファイルがすでに存在しているとき
  overwrite=''
  if [ -f "${filename}.m4a" ] ; then
    ## 短時間（およそ60秒以下）のときは上書きする
    if [ $(filesize "${filename}.m4a") -lt 360000 ] ; then
      overwrite='-y'
    else
      ## 既存の音声ファイルの長さを調べる
      duration=$(ffprobe -loglevel error -show_format -i "${filename}.m4a" | awk -F'=' '$1=="duration" {printf "%d", 0.5+$2}')
      echo 'Existing data duration:' $duration
      echo 'Program duration:' $dur
      ## 音声ファイルが番組の長さよりも短いときは上書きする
      if [ x$duration = x ] || [ $duration -lt $dur ] ; then
        overwrite='-y'
      else
        echo ''
        continue
      fi
    fi
  fi

  ## 音声データをダウンロードしてファイルに保存する
  cp /dev/null $$.files
  ft_unix=$(date_to_unixtime ${ft})
  to_unix=$(date_to_unixtime ${to})
  start_at_unix=${ft_unix}

  ### 音声ファイルを300秒ごとに区切ってダウンロードする
  l=300
  while [ $start_at_unix -lt $to_unix ] ; do
    end_at_unix=$((start_at_unix + l))
    start_at=$(unixtime_to_date $start_at_unix)
    end_at=$(unixtime_to_date $end_at_unix)

    echo ${station_id} ${start_at} ${end_at}
    seek=
    lsid=

    partial_output="$$.${station_id}_${start_at}.aac"
    echo "file ${partial_output}" >>$$.files
    curl -s \
      -H "X-Radiko-Authtoken: ${authtoken}" \
      -H "X-Radiko-AreaId: ${area_id}" \
      "${playlist_m3u8}?station_id=${station_id}&start_at=${start_at}&ft=${ft}&seek=${seek}&end_at=${end_at}&to=${to}&l=${l}&lsid=${lsid}&type=c" \
      | grep -e '^https' >$$.1.m3u8

    headers=$(printf 'X-Radiko-AreaId: %s\r\nX-Radiko-Authtoken: %s\r\n' ${area_id} ${authtoken})
    ffmpeg -nostdin -loglevel error -fflags +discardcorrupt -headers "$headers" -http_seekable 0 -seekable 0 -i "$(cat $$.1.m3u8)" -c copy -vn -bsf:a aac_adtstoasc ${partial_output}

    start_at_unix=$end_at_unix
  done

  ## 音声ファイルを繋いで1つにする
  ffmpeg -nostdin -loglevel error -f concat -safe 0 -i $$.files -c copy -vn $overwrite "${filename}.m4a"
  echo ''
done

## 番組表を保存する
yyyy=$(expr $program_date : '\(....\)....')
mm=$(expr $program_date : '....\(..\)..')
dd=$(expr $program_date : '......\(..\)')
mv $$.program_list "${yyyy}.${mm}.${dd} ${station_name}.xml"

rm $$.*

exit 0
